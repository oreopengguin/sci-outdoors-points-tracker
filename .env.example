# Every value here is optional — the app runs without any of them.
# Copy to .env.local to use them in development.

# --- Persistence -------------------------------------------------------------
# Any Redis-compatible REST endpoint. Vercel's Upstash integration sets these
# two automatically when you add a store to the project.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Where the filesystem fallback writes when no KV store is configured.
# Development only — a serverless deployment needs the KV store above.
# SOT_DATA_DIR=./.data

# --- Teacher account ---------------------------------------------------------
# Defaults to soteacher / meow67. Only the hash is ever stored.
# Generate a new hash with the command in the README.
# TEACHER_USERNAME=soteacher
# TEACHER_PASSWORD_HASH=scrypt$32768$8$1$...$...

# --- Sessions ----------------------------------------------------------------
# Signing key for session cookies. If unset, a random one is generated on first
# use and persisted in the KV store, which is fine for a single deployment.
# AUTH_SECRET=
